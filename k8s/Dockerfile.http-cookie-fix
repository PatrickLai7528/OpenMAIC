# Thin patch on top of the published agent-runtime image.
# Production builds inline `; Secure` onto anonymous_id cookies; browsers on
# plain HTTP (MetalLB :80) drop them, so session GETs 404 as a new owner.
# Prefer rebuilding from source with ANONYMOUS_COOKIE_SECURE=0 once available.
FROM ghcr.io/patricklai7528/openmaic:agent-runtime
USER root
RUN node -e "\
const fs=require('fs'); const path=require('path');\
function walk(d,acc=[]){\
  for (const e of fs.readdirSync(d,{withFileTypes:true})) {\
    const p=path.join(d,e.name);\
    if (e.isDirectory()) walk(p,acc); else if (e.name.endsWith('.js')) acc.push(p);\
  }\
  return acc;\
}\
const needle='Max-Age=2592000; Secure';\
const repl='Max-Age=2592000';\
let n=0;\
for (const f of walk('/app/.next/server')) {\
  const s=fs.readFileSync(f,'utf8');\
  if (!s.includes(needle)) continue;\
  fs.writeFileSync(f, s.split(needle).join(repl));\
  n++;\
}\
if (!n) throw new Error('no Secure cookie strings found to patch');\
console.log('patched files:', n);\
"
USER nextjs
