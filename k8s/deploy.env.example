# Copy to deploy.env (gitignored) and fill in, then:
#   ./apply.sh --env-file ./deploy.env
# Or export inline before ./apply.sh:
#   set -a && source ./deploy.env && set +a && ./apply.sh

NAMESPACE=open-maic

# Required
DATABASE_URL=postgres://open_maic:CHANGE_ME@YOUR_PG_HOST:5432/open_maic
OPENAI_API_KEY=ark-replace-me
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_MODELS=doubao-seed-2-1-pro-260628
IMAGE=ghcr.io/YOUR_USER/openmaic:agent-runtime

# Plain HTTP (MetalLB :80): keep 0 so anonymous_id cookies stick. Use 1 behind HTTPS.
# ANONYMOUS_COOKIE_SECURE=0
# After CI push, prefer a sha tag from the workflow, e.g.:
# IMAGE=ghcr.io/YOUR_USER/openmaic:sha-abc1234

# GHCR private pull (apply.sh creates secret/registry-cred)
GHCR_USERNAME=YOUR_GITHUB_USERNAME
GHCR_TOKEN=ghp_replace_me_read_packages
# GHCR_EMAIL=you@example.com
# GHCR_SERVER=ghcr.io

# Optional. MiniMax is not the chat default; set it only if narration TTS still uses MiniMax.
# MINIMAX_API_KEY=sk-replace-me
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
# MINIMAX_MODELS=MiniMax-M2.7-highspeed
# Server-side TTS for PRO/agent-runtime narration (generate_tts). Without a
# TTS_* provider the agent reports "no enabled server TTS capability".
# TTS_MINIMAX_API_KEY=        # defaults to MINIMAX_API_KEY
# TTS_MINIMAX_BASE_URL=https://api.minimaxi.com
# PERSISTENCE_DEV_TOKEN=openmaic-school-dev
# ACCESS_CODE=
# APPLY_INGRESS=1
