# Copy to deploy.env (gitignored) and fill in, then:
#   set -a && source ./deploy.env && set +a && ./apply.sh
#
# Or export inline before ./apply.sh

NAMESPACE=ky-super-openamic

# Required
DATABASE_URL=postgres://open_maic:CHANGE_ME@YOUR_PG_HOST:5432/open_maic
MINIMAX_API_KEY=sk-replace-me
IMAGE=ghcr.io/YOUR_USER/OpenMAIC:agent-runtime
# After CI push, prefer a digest/sha tag from the workflow, e.g.:
# IMAGE=ghcr.io/YOUR_USER/OpenMAIC:sha-abc1234


# Optional (defaults shown)
# OPENAI_API_KEY=          # defaults to MINIMAX_API_KEY
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# OPENAI_MODELS=MiniMax-M2.7-highspeed
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
# MINIMAX_MODELS=MiniMax-M2.7-highspeed
# PERSISTENCE_DEV_TOKEN=openmaic-school-dev
# ACCESS_CODE=
# APPLY_INGRESS=1
